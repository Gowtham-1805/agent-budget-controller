# Copy to .env and fill in. .env is gitignored and must never be committed.
# Secrets belong in AWS Secrets Manager in deployed environments; this file is
# for local development only.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
ABC_ENVIRONMENT=local
ABC_LOG_LEVEL=INFO
ABC_SERVICE_NAME=agent-budget-controller

# ---------------------------------------------------------------------------
# Budget store
# ---------------------------------------------------------------------------
ABC_AWS_REGION=us-east-1
ABC_TABLE_CORE=abc_core
ABC_TABLE_LEDGER=abc_ledger
# Point at DynamoDB Local for offline development. Leave blank to use real AWS.
ABC_DYNAMODB_ENDPOINT_URL=http://localhost:8000
# In-process store for dev/tests only -- state does not survive a restart,
# which defeats the entire purpose in production. The gateway refuses to start
# with this set to true when ABC_ENVIRONMENT is prod/production.
ABC_USE_MEMORY_STORE=false

# ---------------------------------------------------------------------------
# Enforcement policy defaults
# ---------------------------------------------------------------------------
# Hard ceiling injected when a client omits an output-token limit. Without this
# a client could bypass spend protection simply by not sending max_tokens.
ABC_DEFAULT_MAX_OUTPUT_TOKENS=4096
# Extra basis points added to reservations for models that cannot enforce a
# hard output cap. 200 bps = 2%.
ABC_OVERSHOOT_SAFETY_BPS=200
ABC_PROVIDER_CONNECT_TIMEOUT_S=10
ABC_PROVIDER_READ_TIMEOUT_S=120
# How long a reservation may sit unresolved before the stale-reservation
# sweeper treats it as abandoned.
ABC_RESERVATION_TTL_MINUTES=20
# Where the versioned price catalog is loaded from. Defaults to
# <repo>/pricing/catalog.json; override to point at a different catalog file.
ABC_PRICE_CATALOG_PATH=

# ---------------------------------------------------------------------------
# Provider credentials (local dev only; AWS Secrets Manager in deployed envs)
# ---------------------------------------------------------------------------
# Secrets can also be configured dynamically at runtime by administrators via
# the Operator Dashboard at /settings/providers or via PUT /v1/admin/providers/{provider}.
# In deployed environments, secrets are never stored in plain text.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Bedrock authenticates via the ECS task role in AWS and your ambient AWS
# credentials locally -- no API key to store. Off by default even when
# credentials are present, so enabling it is a deliberate choice.
# In production AWS, authentication uses: ECS Task Role -> AWS IAM -> Amazon Bedrock.
ABC_BEDROCK_ENABLED=false
ABC_BEDROCK_REGION=us-east-1

# Register the deterministic fake provider as "test". Development and demos
# only: it returns canned usage, so any budget it appears to enforce is fictional. The gateway refuses to start with this enabled in production.
ABC_ENABLE_FAKE_PROVIDER=false

# Bootstrap admin credential for the control plane (machine/agent auth). In
# AWS this comes from Secrets Manager; locally, set it to anything you like.
ABC_ADMIN_API_KEY=local-admin-key

# First-run human admin account for the dashboard's login page. If both are
# set and no user exists yet, one admin user is seeded at startup -- without
# this, a fresh deployment has a login page and no way to ever log into it.
ABC_BOOTSTRAP_ADMIN_EMAIL=
ABC_BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Human authentication (dashboard login)
# ---------------------------------------------------------------------------
# Argon2id parameters are a security floor, not a tuning knob -- see
# auth/passwords.py's production-floor test. Leave these at their defaults in
# any deployed environment.
# ABC_ARGON2_TIME_COST=3
# ABC_ARGON2_MEMORY_COST_KIB=65536
# ABC_ARGON2_PARALLELISM=4
# ABC_SESSION_TTL_MINUTES=720
# ABC_SESSION_IDLE_TIMEOUT_MINUTES=60
# Login rate limiting: tier 1 (per-IP, in-process) and tier 2 (per-account,
# durable -- the tier that actually bounds guess rate against one account).
# ABC_LOGIN_IP_LIMIT=10
# ABC_LOGIN_IP_WINDOW_SECONDS=300
# ABC_LOGIN_ACCOUNT_LIMIT=5
# ABC_LOGIN_ACCOUNT_WINDOW_SECONDS=900
# ABC_LOGIN_ACCOUNT_LOCKOUT_CAP_SECONDS=900
# Exact origins only -- never "*". Empty (the default) means no CORS
# middleware at all, which is correct while the dashboard proxies every call
# server-side; only set this if a browser client talks to the gateway directly.
# ABC_CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Observability — strictly outside the authorization path.
# If Langfuse is unreachable, budget enforcement must continue unaffected.
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ABC_LANGFUSE_ENABLED=false
# Prompt/response capture is OFF by default. Budget governance needs usage and
# identity metadata, not the content of the conversation.
ABC_TRACE_CONTENT=false
ABC_OTEL_EXPORTER_OTLP_ENDPOINT=
